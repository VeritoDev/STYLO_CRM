<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/btnBackCita"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:src="@drawable/ic_back"
                    app:tint="@color/toolbar_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/nuevaCita"
                    android:textColor="@color/toolbar_claro"
                    android:textSize="30sp"
                    android:textStyle="bold|italic" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="10dp"
                    android:paddingStart="0dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/toolbar_claro"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/toolbar_claro"
                        app:boxStrokeErrorColor="@android:color/holo_red_dark"
                        app:errorEnabled="true"
                        app:errorIconTint="@android:color/holo_red_dark"
                        app:errorTextColor="@android:color/holo_red_dark"
                        app:hintTextColor="@color/toolbar_claro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaCliente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/telefono"
                            android:textColor="@color/toolbar_claro" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaServicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColorHint="@color/toolbar_claro"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/toolbar_claro"
                        app:boxStrokeErrorColor="@android:color/holo_red_dark"
                        app:errorEnabled="true"
                        app:errorIconTint="@android:color/holo_red_dark"
                        app:errorTextColor="@android:color/holo_red_dark"
                        app:hintTextColor="@color/toolbar_claro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaServicio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/servicio"
                            android:textColor="@color/toolbar_claro" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="0dp"
                    android:paddingStart="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColorHint="@color/toolbar_claro"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/toolbar_claro"
                        app:boxStrokeErrorColor="@android:color/holo_red_dark"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconMode="custom"
                        app:endIconTint="@color/toolbar_claro"
                        app:errorEnabled="true"
                        app:errorIconTint="@android:color/holo_red_dark"
                        app:errorTextColor="@android:color/holo_red_dark"
                        app:hintTextColor="@color/toolbar_claro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaFecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:hint="@string/fecha"
                            android:textColor="@color/toolbar_claro" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitaHora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColorHint="@color/toolbar_claro"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="15dp"
                        app:boxCornerRadiusBottomStart="15dp"
                        app:boxCornerRadiusTopEnd="15dp"
                        app:boxCornerRadiusTopStart="15dp"
                        app:boxStrokeColor="@color/toolbar_claro"
                        app:boxStrokeErrorColor="@android:color/holo_red_dark"
                        app:endIconDrawable="@drawable/ic_clock"
                        app:endIconMode="custom"
                        app:endIconTint="@color/toolbar_claro"
                        app:errorEnabled="true"
                        app:errorIconTint="@android:color/holo_red_dark"
                        app:errorTextColor="@android:color/holo_red_dark"
                        app:hintTextColor="@color/toolbar_claro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitaHora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:hint="@string/hora"
                            android:textColor="@color/toolbar_claro" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardarCita"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="@color/toolbar_oscuro"
                android:text="@string/añadirCita"
                android:textColor="@color/toolbar_claro"
                app:cornerRadius="15dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>